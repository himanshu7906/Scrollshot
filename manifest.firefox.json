{
  "manifest_version": 3,
  "name": "Scrollshot",
  "version": "1.0.0",
  "description": "Scroll, stitch, copy. Capture the full page, the viewport, a dragged region or a single element — straight to your clipboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "scrollshot@windowutility",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scrollshot — capture this page",
    "default_icon": { "48": "icons/icon.svg" }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "capture-fullpage": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Capture full page to clipboard"
    },
    "capture-viewport": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Capture visible viewport to clipboard"
    }
  }
}
