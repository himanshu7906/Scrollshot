{
  "manifest_version": 3,
  "name": "Scrollshot",
  "version": "1.0.0",
  "description": "Scroll, stitch, copy. Capture the full page, the viewport, a dragged region or a single element — straight to your clipboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scrollshot — capture this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-fullpage": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Capture full page to clipboard"
    },
    "capture-viewport": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Capture visible viewport to clipboard"
    }
  }
}
